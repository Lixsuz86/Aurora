// Aurora Language - Phase 4 Syntax & Type Showcase

// High-level: Structs, Enums, and Optionals
struct Point {
    pub x: f64,
    pub y: f64,
}

enum Status {
    Pending,
    Active(i32),
    Failed(string),
}

fn double_it(x: i32) -> i32 {
    return x * 2;
}

fn add_ten(x: i32) -> i32 {
    return x + 10;
}

// High-level: Pipeline
fn calculate(value: i32) -> i32 {
    return value |> double_it() |> add_ten();
}

// Low-level: Unsafe functions, raw pointers, and type casts
unsafe fn raw_write(ptr: *mut u8, value: u8) {
    *ptr = value;
}

// Modern control flow: Pattern matching and if expressions
fn evaluate_status(status: Status) -> string {
    return match status {
        Status::Pending => "Waiting in queue",
        Status::Active(code) => "Process running with code",
        Status::Failed(reason) => "Error encountered",
        _ => "Unknown status",
    };
}

// Main execution block
let mut counter: i32 = 0;
counter = calculate(5);

let score: i64 = 10 + 20 * 3;
return score;
